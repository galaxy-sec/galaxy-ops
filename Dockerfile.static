# Multi-stage Dockerfile for building static gops binary
FROM rust:1.89-alpine AS builder

# Install build dependencies for static compilation
RUN apk add --no-cache \
    musl-dev \
    pkgconfig \
    openssl-dev \
    openssl-libs-static \
    zlib-dev \
    zlib-static \
    git \
    build-base

# Set environment variables for static compilation
ENV RUSTFLAGS="-C target-feature=+crt-static"
ENV OPENSSL_STATIC=1
ENV OPENSSL_LIB_DIR=/usr/lib
ENV OPENSSL_INCLUDE_DIR=/usr/include

# Set working directory
WORKDIR /build

# Copy the entire project
COPY . .

# Install the musl target and build the static binary
RUN rustup target add x86_64-unknown-linux-musl && \
    cargo build --release --target x86_64-unknown-linux-musl --bin gops && \
    file target/x86_64-unknown-linux-musl/release/gops && \
    ldd target/x86_64-unknown-linux-musl/release/gops || true

# Final stage - minimal runtime image
FROM alpine:latest

# Copy the static binary
COPY --from=builder /build/target/x86_64-unknown-linux-musl/release/gops /usr/local/bin/gops

# Make it executable
RUN chmod +x /usr/local/bin/gops

# Create a non-root user
RUN addgroup -g 1001 gops && \
    adduser -D -u 1001 -G gops gops

# Switch to non-root user
USER gops

# Set the entrypoint
ENTRYPOINT ["/usr/local/bin/gops"]

# Default command (show version)
CMD ["--version"]
